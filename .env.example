# ==============================================================================
# CSNN Toronto — Healthy Eating & Lifestyle Certificate Environment Configuration
# ==============================================================================

# Registration Email Delivery Feature Flag
# Defaults to "false" to prevent sending emails until the client authorizes
# official email routing and provides verified SMTP / service credentials.
REGISTRATION_EMAIL_ENABLED=false
NEXT_PUBLIC_REGISTRATION_EMAIL_ENABLED=false

# Client Destination Address (Do NOT configure until authorized by CSNN Toronto administration)
# Example: torontoinfo@csnn.ca
REGISTRATION_DESTINATION_EMAIL=

# Optional Notification Provider (Resend, SendGrid, Postmark, AWS SES, or SMTP)
# EMAIL_SERVER_HOST=
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=
# EMAIL_SERVER_PASSWORD=
# EMAIL_FROM=CSNN Toronto Registration <noreply@csnn.ca>
